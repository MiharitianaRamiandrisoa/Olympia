<IfModule mod_rewrite.c>
    RewriteEngine On

    # Le domaine pointe actuellement vers la racine du projet.
    # Les fichiers publics doivent être servis depuis le dossier public/.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^$ public/index.php [L]

    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>
