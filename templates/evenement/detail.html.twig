{% extends 'base.html.twig' %}
{% block meta_description %}{{ event.titre }} a Olympia Madagascar : date, horaires, lieu et informations sur cet evenement a Tanjombato.{% endblock %}
{% block title %}{{ event.titre }} | Olympia{% endblock %}
{% block structured_data %}
  {{ parent() }}
  <script type="application/ld+json">
    {{ {
      '@context': 'https://schema.org',
      '@type': 'Event',
      'name': event.titre,
      'description': event.description|default(''),
      'startDate': event.dateDebut|date('c'),
      'endDate': event.dateFin ? event.dateFin|date('c') : event.dateDebut|date('c'),
      'eventStatus': 'https://schema.org/EventScheduled',
      'eventAttendanceMode': 'https://schema.org/OfflineEventAttendanceMode',
      'location': {
        '@type': 'Place',
        'name': event.lieu|default('Centre commercial Olympia'),
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': 'Tanjombato',
          'addressCountry': 'MG'
        }
      },
      'organizer': {
        '@type': 'Organization',
        'name': 'Olympia Madagascar'
      }
    }|json_encode|raw }}
  </script>
{% endblock %}
{% block main_background %}bg-white{% endblock %}
{% block body %}
<section class="relative isolate flex min-h-[420px] items-end overflow-hidden bg-olympia-dark text-white lg:min-h-[500px]">
  {% set hero_image_path = event.imageMedia ? event.imageMedia.chemin : 'images/hero-olympia.jpg' %}
  {% set hero_srcset = responsive_srcset(hero_image_path) %}
  <img src="{{ asset(hero_image_path) }}"{% if hero_srcset %} srcset="{{ hero_srcset }}" sizes="100vw"{% endif %} alt="{{ event.titre }}" width="1800" height="700" loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 -z-20 size-full object-cover"><div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-900/90 via-brand-900/65 to-brand-900/20"></div>
  <div class="container-site w-full pb-16 pt-20"><a href="{{ path('app_events') }}" class="text-sm text-white/85 hover:text-white">← Retour aux événements</a><span class="mt-8 block w-fit rounded-full bg-olympia-gold px-4 py-1 text-xs font-bold uppercase text-olympia">Événement</span><h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight md:text-6xl">{{ event.titre }}</h1><div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-white/90"><span>{{ event.dateDebut|date('d/m/Y') }}</span><span>{{ event.dateDebut|date('H\\hi') }}</span>{% if event.lieu %}<span>{{ event.lieu }}</span>{% endif %}</div></div>
</section>
<section class="container-site grid gap-10 py-12 md:grid-cols-2 md:py-16">
  {% set image_path = event.imageMedia ? event.imageMedia.chemin : 'images/Minimal Storefront Badge Illustration.png' %}
  {% set srcset = responsive_srcset(image_path) %}
  <div class="min-h-[360px] overflow-hidden bg-sand-50"><img src="{{ asset(image_path) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 768px) 100vw, 1000px"{% endif %} alt="{{ event.titre }}" width="1000" height="700" loading="lazy" decoding="async" class="size-full object-cover"></div>
  <div class="rounded-2xl bg-sand-50 p-8 md:p-10"><h2 class="text-xl font-bold text-olympia">Informations</h2><dl class="mt-8 space-y-6 text-sm"><div><dt class="font-bold text-olympia">Date</dt><dd class="mt-1 text-olympia-muted">{{ event.dateDebut|date('d/m/Y') }}</dd></div><div><dt class="font-bold text-olympia">Heure</dt><dd class="mt-1 text-olympia-muted">{{ event.dateDebut|date('H\\hi') }}{% if event.dateFin %} – {{ event.dateFin|date('H\\hi') }}{% endif %}</dd></div>{% if event.lieu %}<div><dt class="font-bold text-olympia">Lieu</dt><dd class="mt-1 text-olympia-muted">{{ event.lieu }}</dd></div>{% endif %}</dl><div class="mt-10"><h2 class="text-xl font-bold text-olympia">Description</h2><p class="mt-3 text-sm leading-6 text-olympia-muted">{{ event.description }}</p></div></div>
</section>
<section class="container-site pb-16"><div class="flex flex-col items-start justify-between gap-4 bg-sand-50 px-8 py-7 md:flex-row md:items-center"><div><h2 class="text-2xl font-medium text-olympia">Ne manquez aucun événement !</h2><p class="mt-1 text-sm text-olympia-muted">Consultez toutes les animations du centre commercial.</p></div><a href="{{ path('app_events') }}" class="rounded-full bg-olympia-gold px-6 py-3 text-sm font-bold text-olympia">Voir le calendrier →</a></div></section>
{% endblock %}
