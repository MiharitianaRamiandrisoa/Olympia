{% extends 'base.html.twig' %}
{% block title %}{{ promotion.titre }} | Olympia{% endblock %}
{% block main_background %}bg-white{% endblock %}
{% block body %}
<section class="relative isolate flex min-h-[420px] items-end overflow-hidden bg-olympia-dark text-white lg:min-h-[500px]">
  {% set hero_image_path = promotion.imageMedia ? promotion.imageMedia.chemin : 'images/hero-olympia.jpg' %}
  {% set hero_srcset = responsive_srcset(hero_image_path) %}
  <img src="{{ asset(hero_image_path) }}"{% if hero_srcset %} srcset="{{ hero_srcset }}" sizes="100vw"{% endif %} alt="" width="1800" height="700" loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 -z-20 size-full object-cover">
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-900/90 via-brand-900/65 to-brand-900/20"></div>
  <div class="container-site w-full pb-16 pt-20">
    <a href="{{ path('app_promotions') }}" class="text-sm text-white/85 hover:text-white">← Retour aux offres</a>
    <span class="mt-8 block w-fit rounded-full bg-olympia-gold px-4 py-1 text-xs font-bold uppercase text-olympia">Promotion</span>
    <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight md:text-6xl">{{ promotion.titre }}</h1>
    <p class="mt-6 text-sm text-white/90">Du {{ promotion.dateDebut|date('d/m/Y') }}{% if promotion.dateFin %} au {{ promotion.dateFin|date('d/m/Y') }}{% endif %}</p>
  </div>
</section>
<section class="container-site grid gap-10 py-12 md:grid-cols-2 md:py-16">
  {% set image_path = promotion.imageMedia ? promotion.imageMedia.chemin : 'images/promo/default.jpg' %}
  {% set srcset = responsive_srcset(image_path) %}
  <div class="min-h-[360px] overflow-hidden bg-sand-50"><img src="{{ asset(image_path) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 768px) 100vw, 1000px"{% endif %} alt="{{ promotion.titre }}" width="1000" height="700" loading="lazy" decoding="async" class="size-full object-cover"></div>
  <div class="flex flex-col justify-center">
    <p class="text-sm font-bold uppercase tracking-wide text-olympia-gold">{{ promotion.enseigne.nom }}</p>
    <h2 class="mt-3 text-3xl font-medium text-olympia">{{ promotion.titre }}</h2>
    <p class="mt-5 text-base leading-7 text-olympia-muted">{{ promotion.description }}</p>
    <div class="mt-8 rounded-2xl bg-sand-50 p-6"><p class="font-bold text-olympia">Informations</p><p class="mt-3 text-sm text-olympia-muted">Enseigne : {{ promotion.enseigne.nom }}</p>{% if promotion.conditions %}<p class="mt-2 text-sm text-olympia-muted">{{ promotion.conditions }}</p>{% endif %}</div>
  </div>
</section>
<section class="container-site pb-16"><div class="flex flex-col items-start justify-between gap-4 bg-sand-50 px-8 py-7 md:flex-row md:items-center"><div><h2 class="text-2xl font-medium text-olympia">À ne pas manquer</h2><p class="mt-1 text-sm text-olympia-muted">Découvrez toutes les promotions d'Olympia.</p></div><a href="{{ path('app_promotions') }}" class="rounded-full bg-olympia-gold px-6 py-3 text-sm font-bold text-olympia">Voir toutes les offres →</a></div></section>
{% endblock %}
