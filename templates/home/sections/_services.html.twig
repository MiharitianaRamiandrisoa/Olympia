{% if services is not empty %}
<section class="bg-[#0d3036] py-14 text-white md:py-16">
  <div class="container-site">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-600">À votre service</p>
        <h2 class="mt-2 text-3xl font-medium text-white md:text-4xl">Des services pensés pour votre visite</h2>
        <p class="mt-3 max-w-xl text-sm leading-6 text-blue-100">Découvrez les équipements et services disponibles pour rendre chaque visite à Olympia plus simple et agréable.</p>
      </div>
      <a href="{{ path('app_services') }}" class="inline-flex shrink-0 items-center gap-3 rounded-full border border-sand-300/70 px-6 py-3 text-sm font-semibold text-sand-300 transition hover:bg-sand-300 hover:text-brand-900">
        Découvrir les services
        {% include 'components/ui/_icon.html.twig' with {name: 'arrow-right', class: 'size-4'} only %}
      </a>
    </div>
  </div>
</section>
{% endif %}
