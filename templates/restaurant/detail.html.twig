{% extends 'base.html.twig' %}
{% block meta_description %}Découvrez {{ restaurant.enseigne.nom }} au Food court d'Olympia Madagascar à Tanjombato : cuisine, horaires et informations pratiques.{% endblock %}

{% block title %}{{ restaurant.enseigne.nom }} à Olympia Madagascar | Restaurant{% endblock %}
{% block main_background %}bg-white{% endblock %}

{% block body %}
  <section class="container-site py-8 md:py-12">
    <a href="{{ path('app_restaurants') }}" class="text-sm font-medium text-olympia hover:underline">← Retour au Food court</a>

    <div class="mt-8 grid gap-10 md:grid-cols-2 md:items-start">
      <div class="flex min-h-[280px] items-center justify-center overflow-hidden rounded-2xl bg-sand-50 p-5 sm:min-h-[360px] sm:p-8">
        {% set image_path = restaurant.photoMedia ? restaurant.photoMedia.chemin : 'images/Minimal Storefront Badge Illustration.png' %}
        {% set srcset = responsive_srcset(image_path) %}
        <img src="{{ optimized_image(image_path) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 768px) 100vw, 1000px"{% endif %} alt="{{ restaurant.enseigne.nom }}" width="1000" height="700" loading="lazy" decoding="async" class="h-auto max-h-[300px] max-w-full object-contain sm:max-h-[420px]">
      </div>

      <div class="py-2 md:py-8">
        <p class="text-sm font-bold uppercase tracking-wide text-olympia-gold">{{ restaurant.categorie ? restaurant.categorie.nom : 'Food court' }}</p>
        <h1 class="mt-3 text-4xl font-semibold text-olympia md:text-5xl">{{ restaurant.enseigne.nom }}</h1>

        {% if restaurant.description %}
          <p class="mt-6 text-base leading-7 text-olympia-muted">{{ restaurant.description }}</p>
        {% endif %}

        <div class="mt-8 rounded-2xl bg-sand-50 p-6">
          <h2 class="text-lg font-bold text-olympia">Informations</h2>
          {% if restaurant.horairesAffichage %}<p class="mt-4 whitespace-pre-line text-sm text-olympia-muted">Horaires : {{ restaurant.horairesAffichage }}</p>{% endif %}
          {% if restaurant.enseigne.telephone %}<p class="mt-2 text-sm text-olympia-muted">Téléphone : {{ restaurant.enseigne.telephone }}</p>{% endif %}
          {% if restaurant.enseigne.siteWeb %}<a href="{{ restaurant.enseigne.siteWeb }}" class="mt-2 block text-sm font-medium text-olympia hover:underline" target="_blank" rel="noopener">Visiter le site</a>{% endif %}
        </div>
      </div>
    </div>
  </section>

  {% if restaurant_photos is not empty %}
    <section class="border-t border-sand-200 bg-sand-50 py-12 md:py-16">
      <div class="container-site">
        <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-olympia-gold">L’ambiance</p>
            <h2 class="mt-2 text-3xl font-semibold text-olympia">Photos du restaurant</h2>
          </div>
          <p class="max-w-md text-sm leading-6 text-olympia-muted">Découvrez le cadre et l’atmosphère de {{ restaurant.enseigne.nom }}.</p>
        </div>

        <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
          {% for photo in restaurant_photos %}
            {% set photo_path = photo.imageMedia ? photo.imageMedia.chemin : null %}
            {% if photo_path %}
              <a href="{{ asset(photo_path) }}" target="_blank" rel="noopener" class="group relative overflow-hidden rounded-2xl bg-white shadow-sm md:first:col-span-2 md:first:row-span-2">
                <img src="{{ optimized_image(photo_path) }}"{% set photo_srcset = responsive_srcset(photo_path) %}{% if photo_srcset %} srcset="{{ photo_srcset }}" sizes="(max-width: 768px) 50vw, 25vw"{% endif %} alt="{{ photo.legende ?: 'Photo du restaurant ' ~ restaurant.enseigne.nom }}" width="800" height="600" loading="lazy" decoding="async" class="aspect-[4/3] size-full object-cover transition duration-300 group-hover:scale-105 md:first:aspect-square">
                {% if photo.legende %}<span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pb-3 pt-8 text-sm text-white">{{ photo.legende }}</span>{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if restaurant_plats is not empty %}
    <section class="container-site py-12 md:py-16">
      <div class="mb-7">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-olympia-gold">À déguster</p>
        <h2 class="mt-2 text-3xl font-semibold text-olympia">Nos plats</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for plat in restaurant_plats %}
          <article class="overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-sm">
            {% if plat.imageMedia %}
              {% set plat_path = plat.imageMedia.chemin %}
              {% set plat_srcset = responsive_srcset(plat_path) %}
              <img src="{{ optimized_image(plat_path) }}"{% if plat_srcset %} srcset="{{ plat_srcset }}" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"{% endif %} alt="{{ plat.nom }} - {{ restaurant.enseigne.nom }}" width="800" height="600" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover">
            {% else %}
              <div class="flex aspect-[4/3] items-center justify-center bg-sand-100 text-4xl" aria-hidden="true">🍽️</div>
            {% endif %}
            <div class="p-5">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-xl font-semibold text-olympia">{{ plat.nom }}</h3>
                {% if plat.prix is not null %}<span class="shrink-0 text-sm font-bold text-olympia-gold">{{ plat.prix|number_format(0, ',', ' ') }} Ar</span>{% endif %}
              </div>
              {% if plat.description %}<p class="mt-3 text-sm leading-6 text-olympia-muted">{{ plat.description }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}
{% endblock %}
