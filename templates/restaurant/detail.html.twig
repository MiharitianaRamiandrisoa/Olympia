{% extends 'base.html.twig' %}
{% block meta_description %}Decouvrez le restaurant {{ restaurant.enseigne.nom }} au centre commercial Olympia a Tanjombato : cuisine, horaires et informations pratiques.{% endblock %}

{% block title %}{{ restaurant.enseigne.nom }} | Olympia{% endblock %}
{% block main_background %}bg-white{% endblock %}

{% block body %}
  <section class="container-site py-8 md:py-12">
    <a href="{{ path('app_restaurants') }}" class="text-sm font-medium text-olympia hover:underline">← Retour aux restaurants</a>

    <div class="mt-8 grid gap-10 md:grid-cols-2 md:items-start">
      <div class="min-h-[360px] overflow-hidden rounded-2xl bg-sand-50">
        {% set image_path = restaurant.photoMedia ? restaurant.photoMedia.chemin : 'images/resto/default.jpg' %}
        {% set srcset = responsive_srcset(image_path) %}
        <img src="{{ asset(image_path) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 768px) 100vw, 1000px"{% endif %} alt="{{ restaurant.enseigne.nom }}" width="1000" height="700" loading="lazy" decoding="async" class="size-full object-cover">
      </div>

      <div class="py-2 md:py-8">
        <p class="text-sm font-bold uppercase tracking-wide text-olympia-gold">{{ restaurant.categorie ? restaurant.categorie.nom : 'Restaurant' }}</p>
        <h1 class="mt-3 text-4xl font-semibold text-olympia md:text-5xl">{{ restaurant.enseigne.nom }}</h1>

        {% if restaurant.description %}
          <p class="mt-6 text-base leading-7 text-olympia-muted">{{ restaurant.description }}</p>
        {% endif %}

        <div class="mt-8 rounded-2xl bg-sand-50 p-6">
          <h2 class="text-lg font-bold text-olympia">Informations</h2>
          {% if restaurant.horairesAffichage %}<p class="mt-4 whitespace-pre-line text-sm text-olympia-muted">Horaires : {{ restaurant.horairesAffichage }}</p>{% endif %}
          {% if restaurant.enseigne.telephone %}<p class="mt-2 text-sm text-olympia-muted">Téléphone : {{ restaurant.enseigne.telephone }}</p>{% endif %}
          {% if restaurant.enseigne.siteWeb %}<a href="{{ restaurant.enseigne.siteWeb }}" class="mt-2 block text-sm font-medium text-olympia hover:underline" target="_blank" rel="noopener">Visiter le site</a>{% endif %}
        </div>
      </div>
    </div>
  </section>
{% endblock %}
