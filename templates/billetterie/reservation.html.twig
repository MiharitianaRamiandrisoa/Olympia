{% extends 'base.html.twig' %}
{% block title %}Reserver une place | {{ event.titre }}{% endblock %}
{% block meta_description %}Reservez votre place pour {{ event.titre }} a Olympia Madagascar.{% endblock %}
{% block body %}
<section class="container-site py-12 md:py-16">
  <a href="{{ path('app_event_detail', {slug: event.slug}) }}" class="text-sm font-semibold text-olympia-muted hover:text-olympia">← Retour a l evenement</a>
  <div class="mx-auto mt-8 grid max-w-5xl gap-10 lg:grid-cols-[.8fr_1.2fr]">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-olympia-sage">Billetterie Olympia</p>
      <h1 class="mt-3 text-4xl font-semibold text-olympia">Reserver votre place</h1>
      <h2 class="mt-5 text-xl font-semibold">{{ event.titre }}</h2>
      <dl class="mt-6 space-y-4 text-sm text-olympia-muted">
        <div><dt class="font-bold text-olympia">Date</dt><dd>{{ event.dateDebut|date('d/m/Y a H\\hi') }}</dd></div>
        {% if event.lieu %}<div><dt class="font-bold text-olympia">Lieu</dt><dd>{{ event.lieu }}</dd></div>{% endif %}
        <div><dt class="font-bold text-olympia">Tarif</dt><dd>{{ event.isGratuit ? 'Gratuit' : 'Paiement simule pour test' }}</dd></div>
        {% if places_restantes is not null %}<div><dt class="font-bold text-olympia">Disponibilite</dt><dd>{{ places_restantes }} place{{ places_restantes == 1 ? '' : 's' }} restante{{ places_restantes == 1 ? '' : 's' }}</dd></div>{% endif %}
      </dl>
      <p class="mt-8 rounded-xl border border-olympia-gold/60 bg-sand-50 p-4 text-sm leading-6 text-olympia-muted">Un billet individuel sera genere pour chaque place. Gardez l e-mail de confirmation ou le lien securise vers vos billets.</p>
    </div>
    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-olympia-gold/40 md:p-8">
      {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.nom, {attr: {class: 'field'}}) }}
        {{ form_row(form.email, {attr: {class: 'field'}}) }}
        {{ form_row(form.telephone, {attr: {class: 'field'}}) }}
        {{ form_row(form.nombrePlaces, {attr: {class: 'field'}}) }}
        {{ form_widget(form.submit, {attr: {class: 'w-full rounded-full bg-olympia px-6 py-3 text-sm font-bold text-white transition hover:bg-olympia-dark'}}) }}
      {{ form_end(form) }}
    </div>
  </div>
</section>
{% endblock %}
