{% extends 'base.html.twig' %}
{% block title %}Reservation {{ reservation.reference }} | Olympia{% endblock %}
{% block body %}
<section class="container-site py-12 md:py-20">
  <div class="mx-auto max-w-3xl rounded-2xl bg-white p-7 text-center shadow-sm ring-1 ring-olympia-gold/40 md:p-12">
    {% if reservation.statut == constant('App\\Entity\\Reservation::STATUT_CONFIRMEE') %}
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-olympia text-2xl text-white">✓</span>
      <p class="mt-6 text-xs font-bold uppercase tracking-[0.16em] text-olympia-sage">Reservation confirmee</p>
      <h1 class="mt-3 text-4xl font-semibold text-olympia">Merci {{ reservation.nom }}</h1>
      <p class="mt-4 text-olympia-muted">Votre reference est <strong class="text-olympia">{{ reservation.reference }}</strong>. {{ reservation.nombrePlaces }} billet{{ reservation.nombrePlaces == 1 ? '' : 's' }} {{ reservation.nombrePlaces == 1 ? 'est' : 'sont' }} disponible{{ reservation.nombrePlaces == 1 ? '' : 's' }}.</p>
      {% if email_sent %}<p class="mt-4 text-sm text-olympia-sage">Un e-mail de confirmation a ete envoye.</p>{% else %}<p class="mt-4 text-sm text-amber-700">Le lien ci-dessous est disponible. L e-mail sera active apres configuration SMTP.</p>{% endif %}
      <a href="{{ path('app_ticket_wallet', {token: access_token}) }}" class="mt-8 inline-flex rounded-full bg-olympia-gold px-7 py-3 text-sm font-bold text-olympia">Voir mes billets</a>
    {% elseif reservation.statut == constant('App\\Entity\\Reservation::STATUT_EN_ATTENTE_PAIEMENT') %}
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-olympia-sage">Demande enregistree</p>
      <h1 class="mt-3 text-4xl font-semibold text-olympia">Paiement en attente</h1>
      <p class="mt-4 text-olympia-muted">La reservation {{ reservation.reference }} est conservee comme demande non reglee. Aucun billet n est emis avant la validation du paiement.</p>
      {% if reservation.dateExpirationPaiement %}<p class="mt-3 text-sm text-amber-700">Le paiement doit etre valide avant le {{ reservation.dateExpirationPaiement|date('d/m/Y a H\\hi') }}.</p>{% endif %}
      <a href="{{ path('app_reservation_payment_simulation', {token: access_token}) }}" class="mt-8 inline-flex rounded-full bg-olympia-gold px-7 py-3 text-sm font-bold text-olympia">Payer maintenant</a>
    {% else %}
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-700">Reservation annulee</p>
      <h1 class="mt-3 text-4xl font-semibold text-olympia">Reservation indisponible</h1>
      <p class="mt-4 text-olympia-muted">Cette reservation n est plus active.</p>
    {% endif %}
    <a href="{{ path('app_events') }}" class="mt-6 block text-sm font-semibold text-olympia-muted hover:text-olympia">Retour aux evenements</a>
  </div>
</section>
{% endblock %}
