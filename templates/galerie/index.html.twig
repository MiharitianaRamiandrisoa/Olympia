{% extends 'base.html.twig' %}

{% block title %}Galerie | Olympia Madagascar{% endblock %}
{% block meta_description %}Découvrez la galerie d’Olympia : peintures, photographies, sculptures et illustrations d’artistes malgaches.{% endblock %}

{% block main_background %}bg-olympia-cream{% endblock %}

{% block body %}
  <div class="gallery-page">
    <section class="gallery-hero">
      <div class="container-site gallery-hero-grid">
        <div>
          <p class="gallery-eyebrow"><i></i>Olympia · Tanjombato</p>
          <h1>La Galerie<span>d’Olympia</span></h1>
          <p class="gallery-lead">Un musée de poche ouvert à tous. Peintres, photographes et sculpteurs malgaches exposent ici, à portée d’un clic.</p>
        </div>
        <div class="gallery-hero-art" aria-hidden="true">
          <div class="gallery-frame gallery-frame-a"><i class="gallery-art" data-art="0"></i></div>
          <div class="gallery-frame gallery-frame-b"><i class="gallery-art" data-art="2"></i></div>
          <div class="gallery-frame gallery-frame-c"><i class="gallery-art" data-art="4"></i></div>
        </div>
      </div>
    </section>

    <div class="gallery-band" aria-hidden="true"><div>Peinture ◆ Photographie ◆ Sculpture ◆ Illustration ◆ Art textile ◆ Peinture ◆ Photographie ◆ Sculpture ◆ Illustration ◆ Art textile ◆</div></div>

    <main class="container-site">
      <section class="gallery-section" id="oeuvres">
        <div class="gallery-heading">
          <div><p class="gallery-eyebrow"><i></i>Collection</p><h2>Les œuvres exposées</h2></div>
          <div class="gallery-pills" id="gallery-pills"></div>
        </div>
        <div class="gallery-wall{% if not works %} is-empty{% endif %}" id="gallery-wall">
          {% if not works %}<p class="gallery-empty">La collection est en cours de préparation. Les prochaines œuvres seront bientôt disponibles.</p>{% endif %}
        </div>
      </section>

      <section class="gallery-section gallery-artists-section"{% if not works %} hidden{% endif %}>
        <div class="gallery-heading"><div><p class="gallery-eyebrow"><i></i>Les artistes</p><h2>Ceux qui font vivre les murs</h2></div></div>
        <div class="gallery-artists" id="gallery-artists"></div>
      </section>
    </main>
  </div>

  <dialog class="gallery-dialog" id="gallery-dialog">
    <div class="gallery-lightbox">
      <div class="gallery-lightbox-art"><div class="gallery-frame"><i class="gallery-art" id="gallery-lightbox-art"></i></div></div>
      <div class="gallery-lightbox-info">
        <button class="gallery-close" type="button" aria-label="Fermer" id="gallery-close">×</button>
        <p class="gallery-eyebrow" id="gallery-lightbox-category"></p>
        <h2 id="gallery-lightbox-title"></h2>
        <dl id="gallery-lightbox-details"></dl>
        <p class="gallery-lightbox-description">Description de l’œuvre disponible auprès de l’équipe Olympia.</p>
        <a class="gallery-cta" href="{{ path('app_contact') }}">Contacter Olympia <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </dialog>
{% endblock %}

{% block javascripts %}
  <script>
    const GALLERY_ARTS = [
      'url("https://images.unsplash.com/photo-1577083552431-6e5fd01aa342?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat',
      'url("https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat',
      'url("https://images.unsplash.com/photo-1549490349-8643362247b5?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat',
      'url("https://images.unsplash.com/photo-1578301978018-3005759f48f7?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat',
      'url("https://images.unsplash.com/photo-1561214115-f2f134cc4912?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat',
      'url("https://images.unsplash.com/photo-1577083288073-40892c0860a4?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat',
      'url("https://images.unsplash.com/photo-1541961017774-22349e4a1262?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat',
      'url("https://images.unsplash.com/photo-1579783901586-d88db74b4fe4?auto=format&fit=crop&w=1200&q=85") center/cover no-repeat'
    ];
    const GALLERY_WORKS = {{ works|json_encode|raw }};
    const galleryWall = document.getElementById('gallery-wall');
    const galleryPills = document.getElementById('gallery-pills');
    const galleryDialog = document.getElementById('gallery-dialog');
    const artCss = (index, image = null) => image
      ? `background-image:url("${image}");background-size:contain;background-repeat:no-repeat;background-position:center;background-color:#f4efe3`
      : `background:${GALLERY_ARTS[index % GALLERY_ARTS.length]}`;

    document.querySelectorAll('[data-art]').forEach((element) => element.setAttribute('style', artCss(Number(element.dataset.art))));

    GALLERY_WORKS.forEach((work, index) => {
      const piece = document.createElement('button');
      piece.type = 'button';
      piece.className = 'gallery-piece';
      piece.dataset.category = work.category;
      piece.setAttribute('aria-label', `Ouvrir ${work.title}`);
      piece.innerHTML = `<div class="gallery-frame" style="aspect-ratio:${work.ratio}"><i class="gallery-art" style="${artCss(index, work.image)}">${work.image ? `<img src="${work.image}" alt="${work.title}" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block" onerror="this.remove()">` : ''}</i></div><div class="gallery-tag"><b>${work.title}</b><span>${work.artist} · ${work.category} · ${work.year}</span></div>`;
      piece.addEventListener('click', () => {
        document.getElementById('gallery-lightbox-art').setAttribute('style', artCss(index, work.image));
        document.getElementById('gallery-lightbox-category').textContent = work.category;
        document.getElementById('gallery-lightbox-title').textContent = work.title;
        document.getElementById('gallery-lightbox-details').innerHTML = `<dt>Artiste</dt><dd>${work.artist}</dd><dt>Année</dt><dd>${work.year}</dd><dt>Technique</dt><dd>${work.medium}</dd><dt>Dimensions</dt><dd>${work.size}</dd>`;
        galleryDialog.showModal();
      });
      galleryWall.appendChild(piece);
    });

    ['Toutes', ...new Set(GALLERY_WORKS.map((work) => work.category))].forEach((category, index) => {
      const pill = document.createElement('button');
      pill.type = 'button'; pill.className = `gallery-pill${index ? '' : ' is-active'}`; pill.textContent = category;
      pill.addEventListener('click', () => {
        galleryPills.querySelectorAll('.gallery-pill').forEach((item) => item.classList.remove('is-active'));
        pill.classList.add('is-active');
        galleryWall.querySelectorAll('.gallery-piece').forEach((item) => item.classList.toggle('is-hidden', index > 0 && item.dataset.category !== category));
      });
      galleryPills.appendChild(pill);
    });

    [...new Set(GALLERY_WORKS.map((work) => work.artist))].forEach((artist) => {
      const count = GALLERY_WORKS.filter((work) => work.artist === artist).length;
      const artistId = GALLERY_WORKS.find((work) => work.artist === artist)?.artistId;
      const artistUrl = artistId ? `{{ path('app_galerie_artiste_detail', {'id': 0}) }}`.replace('/0', `/${artistId}`) : '#oeuvres';
      document.getElementById('gallery-artists').insertAdjacentHTML('beforeend', `<a class="gallery-artist" href="${artistUrl}"><div class="gallery-initial">${artist[0]}</div><b>${artist}</b><span>${count} œuvre${count > 1 ? 's' : ''} exposée${count > 1 ? 's' : ''}</span></a>`);
    });

    document.getElementById('gallery-close').addEventListener('click', () => galleryDialog.close());
    galleryDialog.addEventListener('click', (event) => { if (event.target === galleryDialog) galleryDialog.close(); });
  </script>
{% endblock %}
