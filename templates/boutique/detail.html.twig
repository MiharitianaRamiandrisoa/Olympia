{% extends 'base.html.twig' %}
{% block meta_description %}Découvrez {{ boutique.enseigne.nom }} à Olympia Madagascar à Tanjombato : horaires, informations et coordonnées de la boutique.{% endblock %}

{% block title %}{{ boutique.enseigne.nom }} à Olympia Madagascar | Boutique{% endblock %}
{% block main_background %}bg-white{% endblock %}

{% block body %}
  {% set public_description = boutique.description %}
  <section class="container-site py-8 md:py-12">
    <a href="{{ path('app_enseignes') }}" class="text-sm font-medium text-olympia hover:underline">← Retour aux enseignes</a>

    <div class="mt-8 grid gap-10 md:grid-cols-2 md:items-start">
      <div class="flex min-h-[280px] items-center justify-center overflow-hidden rounded-2xl bg-sand-50 p-5 sm:min-h-[360px] sm:p-8">
        {% set image_path = boutique.photoMedia ? boutique.photoMedia.chemin : 'images/Minimal Storefront Badge Illustration.png' %}
        {% set srcset = responsive_srcset(image_path) %}
        <img src="{{ optimized_image(image_path) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 768px) 100vw, 1000px"{% endif %} width="1000" height="700" loading="lazy" decoding="async"
             alt="{{ boutique.enseigne.nom }}"
             class="h-auto max-h-[300px] max-w-full object-contain sm:max-h-[420px]">
      </div>

      <div class="py-2 md:py-8">
        <p class="text-sm font-bold uppercase tracking-wide text-olympia-gold">
          {{ boutique.categorie ? boutique.categorie.nom : 'Boutique' }}
        </p>
        <h1 class="mt-3 text-4xl font-semibold text-olympia md:text-5xl">{{ boutique.enseigne.nom }}</h1>

        {% if public_description %}
          <p class="mt-6 whitespace-pre-line text-base leading-7 text-olympia-muted">{{ public_description }}</p>
        {% endif %}

        <div class="mt-8 rounded-2xl bg-sand-50 p-6">
          <h2 class="text-lg font-bold text-olympia">Informations</h2>
          {% if boutique.horairesAffichage %}
            <p class="mt-4 whitespace-pre-line text-sm text-olympia-muted">Horaires : {{ boutique.horairesAffichage }}</p>
          {% endif %}
          {% if boutique.enseigne.telephone %}
            <p class="mt-2 text-sm text-olympia-muted">Téléphone : {{ boutique.enseigne.telephone }}</p>
          {% endif %}
          {% if boutique.enseigne.siteWeb %}
            <a href="{{ boutique.enseigne.siteWeb }}" class="mt-2 block text-sm font-medium text-olympia hover:underline" target="_blank" rel="noopener">Visiter le site de l'enseigne</a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% if boutique_photos is not empty %}
    <section class="border-t border-sand-200 bg-sand-50 py-12 md:py-16">
      <div class="container-site">
        <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-olympia-gold">L’univers de l’enseigne</p>
            <h2 class="mt-2 text-3xl font-semibold text-olympia">Photos de la boutique</h2>
          </div>
          <p class="max-w-md text-sm leading-6 text-olympia-muted">Découvrez l’espace et l’ambiance de {{ boutique.enseigne.nom }}.</p>
        </div>

        <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
          {% for photo in boutique_photos %}
            {% set photo_path = photo.imageMedia ? photo.imageMedia.chemin : null %}
            {% if photo_path %}
              <figure class="group relative overflow-hidden rounded-[2rem] bg-olympia-dark md:first:col-span-2 md:first:row-span-2">
                <a href="{{ asset(photo_path) }}" target="_blank" rel="noopener" aria-label="Agrandir la photo de {{ boutique.enseigne.nom }}" class="relative block aspect-[4/3] h-full overflow-hidden md:first:aspect-square">
                  {% set photo_srcset = responsive_srcset(photo_path) %}
                  <img src="{{ optimized_image(photo_path) }}"{% if photo_srcset %} srcset="{{ photo_srcset }}" sizes="(max-width: 768px) 50vw, 25vw"{% endif %} alt="{{ photo.description ?: photo.legende ?: 'Photo de la boutique ' ~ boutique.enseigne.nom }}" width="800" height="600" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105">
                  <span class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></span>
                  <span class="absolute right-4 top-4 rounded-full bg-white/85 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-olympia opacity-0 backdrop-blur transition group-hover:opacity-100">Voir la photo</span>
                  {% if photo.legende or photo.description %}
                    <span class="absolute inset-x-0 bottom-0 p-4 text-white sm:p-5">
                      {% if photo.legende %}<strong class="block text-base font-semibold sm:text-lg">{{ photo.legende }}</strong>{% endif %}
                      {% if photo.description %}<span class="mt-1 block text-xs leading-5 text-white/85 sm:text-sm">{{ photo.description }}</span>{% endif %}
                    </span>
                  {% endif %}
                </a>
              </figure>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
{% endblock %}
