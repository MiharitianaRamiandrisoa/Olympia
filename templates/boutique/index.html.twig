{% extends 'base.html.twig' %}
{% block meta_description %}Découvrez les enseignes du centre commercial Olympia à Tanjombato : boutiques, services, mode, beauté, maison et technologie.{% endblock %}
{% block title %}Nos enseignes | Olympia{% endblock %}

{% block hero %}
  {% include 'components/_hero.html.twig' with {
    title: 'Nos enseignes',
    subtitle: 'Découvrez les enseignes présentes à Olympia',
    image: 'images/hero-boutiques.jpg',
    search_placeholder: 'Rechercher une enseigne, une marque...',
    search_action: path('app_enseignes')
  } only %}
{% endblock %}

{% block filters %}
  <div id="boutique-filters">
    {% include 'components/_filter_pills.html.twig' with {
      items: categories,
      active: active_category,
      filter_route: 'app_enseignes'
    } only %}
  </div>
{% endblock %}

{% block body %}
  <div class="container-site grid gap-8 py-10 lg:grid-cols-[280px_1fr]">
    <aside id="boutique-sort" class="h-fit rounded-2xl border border-slate-200 bg-white p-6">
      <h2 class="mb-4 text-xl font-medium">Trier par</h2>
      <ul class="space-y-1 text-sm">
        {% for opt in [
          {label: 'Toutes les enseignes', value: 'all'},
          {label: 'A à Z', value: 'name'},
          {label: 'Catégorie', value: 'category'}
        ] %}
          <li>
            <a href="{{ path('app_enseignes', {q: search, category: active_category, sort: opt.value}) }}" data-boutique-ajax
               class="block rounded-lg px-3 py-3 {{ active_sort == opt.value ? 'bg-olympia-cream font-medium text-olympia' : 'hover:bg-slate-50' }}">
              {{ opt.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </aside>

    <section id="boutique-results">
      <div class="mb-6 flex items-center justify-between gap-4">
        <p class="text-xs font-bold uppercase text-olympia-gold">{{ shops|length }} enseignes trouvées</p>
        {% if search or active_category %}<a href="{{ path('app_enseignes') }}" class="text-sm font-medium text-olympia hover:underline">Réinitialiser</a>{% endif %}
      </div>
      <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-3">
        {% for shop in shops %}
          {% include 'components/_card_boutique.html.twig' with {shop: shop} only %}
        {% else %}
          <p class="text-sm text-olympia-muted">Aucune enseigne ne correspond à votre recherche.</p>
        {% endfor %}
      </div>
      {% include 'components/_pagination.html.twig' with {pagination: pagination} only %}
    </section>
  </div>
{% endblock %}
