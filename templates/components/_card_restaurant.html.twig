{# Params : resto {name, cuisine, floor, image, url} #}
<article class="card flex flex-col">
  {% set srcset = responsive_srcset(resto.image) %}
  <div class="flex h-40 w-full items-center justify-center bg-sand-50 p-4">
    <img src="{{ optimized_image(resto.image) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 600px"{% endif %} alt="Logo {{ resto.name }}" width="600" height="400" class="size-full object-contain" loading="lazy" decoding="async">
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-medium">{{ resto.name }}</h3>
    <p class="mt-1 flex items-center gap-2 text-sm text-olympia-muted">
      {{ resto.cuisine }}
      <span class="h-1 w-1 rounded-full bg-olympia-gold"></span>
      <span class="font-bold text-olympia">{{ resto.floor }}</span>
    </p>
    <a href="{{ resto.url|default('#') }}" class="btn-outline mt-5 font-bold text-olympia">Découvrir la fiche</a>
  </div>
</article>
