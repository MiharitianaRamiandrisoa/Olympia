<section class="container-site pb-20">
  <div class="rounded-3xl bg-olympia px-6 py-14 text-center text-white">
    <h2 class="text-3xl font-medium">Ne manquez pas nos prochaines offres !</h2>
    <p class="mt-4 text-white/80">Inscrivez-vous à notre newsletter pour recevoir toutes les exclusivités d'Olympia.</p>
    <button type="button" data-newsletter-open class="mt-8 inline-block rounded-full bg-olympia-gold px-8 py-3.5 text-sm font-bold text-olympia-dark transition hover:brightness-95">S'inscrire gratuitement</button>
  </div>
</section>

<div id="newsletter-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-olympia-dark/70 px-4" role="dialog" aria-modal="true" aria-labelledby="newsletter-title">
  <div class="w-full max-w-md rounded-3xl bg-white p-8 shadow-2xl">
    <div class="flex items-start justify-between gap-4">
      <div><h2 id="newsletter-title" class="text-2xl font-bold text-olympia">Recevoir les offres</h2><p class="mt-2 text-sm text-olympia-muted">Ajoutez votre adresse email pour recevoir les nouvelles promotions.</p></div>
      <button type="button" data-newsletter-close class="text-2xl leading-none text-olympia-muted" aria-label="Fermer">&times;</button>
    </div>
    <form data-newsletter-form action="{{ path('app_newsletter_subscribe') }}" method="post" class="mt-6 space-y-4">
      <label class="block text-sm font-medium text-olympia" for="newsletter-email">Adresse email</label>
      <input id="newsletter-email" name="email" type="email" required autocomplete="email" class="field" placeholder="vous@exemple.com">
      <p data-newsletter-message class="hidden text-sm"></p>
      <button type="submit" class="w-full rounded-full bg-olympia py-3 font-bold text-white">S'inscrire</button>
    </form>
  </div>
</div>
