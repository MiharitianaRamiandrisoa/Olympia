{% set current = app.request.attributes.get('_route') %}
{% set links = [
  {label: 'Accueil', route: 'app_home'},
  {label: 'Boutiques', route: 'app_boutiques'},
  {label: 'Restaurants', route: 'app_restaurants'},
  {label: 'Promotions', route: 'app_promotions'},
  {label: 'Événements', route: 'app_events'},
  {label: 'Info pratiques', route: 'app_contact'},
] %}
<header class="sticky top-0 z-40 border-b border-slate-100 bg-white" data-controller="mobile-menu">
  <div class="container-site flex h-[88px] items-center justify-between gap-6">
    <a href="{{ path('app_home') }}" aria-label="Olympia - Accueil">
      <img src="{{ asset('images/logo/logo-header-teal.png') }}" alt="Olympia" width="160" height="114" decoding="async" class="h-14 w-auto">
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navigation principale">
      {% for link in links %}
        <a href="{{ path(link.route) }}"
           class="text-[15px] transition hover:text-olympia {{ current == link.route ? 'font-medium text-olympia' : 'text-olympia-muted' }}">
          {{ link.label }}
        </a>
      {% endfor %}
    </nav>

    <div class="flex items-center gap-4">
      <a href="{{ path('app_home') }}#localisation"
         class="hidden rounded-full bg-olympia px-6 py-3 text-sm font-bold text-white transition hover:bg-olympia-dark sm:inline-block">
        Nous trouver
      </a>
      <button type="button" class="lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" data-action="mobile-menu#toggle">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <nav class="hidden border-t border-slate-100 bg-white lg:hidden" data-mobile-menu-target="panel" aria-label="Menu mobile">
    <ul class="container-site flex flex-col py-3">
      {% for link in links %}
        <li>
          <a href="{{ path(link.route) }}" class="block py-3 text-base text-olympia hover:text-olympia-dark">{{ link.label }}</a>
        </li>
      {% endfor %}
      <li class="pt-2">
         <a href="{{ path('app_home') }}#localisation" class="block rounded-full bg-olympia py-3 text-center font-bold text-white">Nous trouver</a>
      </li>
    </ul>
  </nav>
</header>
