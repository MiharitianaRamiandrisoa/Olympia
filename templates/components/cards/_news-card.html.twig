{# Params : badge, title, icon, date, text, image, href #}
<article class="flex flex-col overflow-hidden rounded-xl border border-brand-900/10 bg-white shadow-sm">
  {% set srcset = responsive_srcset(image) %}
  <img src="{{ asset(image) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 700px"{% endif %} alt="" width="700" height="440" loading="lazy" decoding="async" class="h-44 w-full object-cover">
  <div class="flex flex-1 flex-col p-5">
    <span class="w-fit rounded-full bg-brand-900/80 px-2.5 py-0.5 text-[10px] font-semibold uppercase text-white">{{ badge }}</span>
    <h3 class="mt-2 text-lg font-semibold">{{ title }}</h3>
    <p class="mt-1 flex items-center gap-1.5 text-xs text-brand-900/60">
      {% include 'components/ui/_icon.html.twig' with {name: icon, class: 'size-3.5'} only %}{{ date }}
    </p>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-brand-900/70">{{ text }}</p>
    <a href="{{ href }}" class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-900">
      En savoir plus
      {% include 'components/ui/_icon.html.twig' with {name: 'arrow-right', class: 'size-3.5'} only %}
    </a>
  </div>
</article>
