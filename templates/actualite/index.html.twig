{% extends 'base.html.twig' %}

{% block title %}Actualités | Olympia{% endblock %}
{% block meta_description %}Découvrez les dernières actualités du centre commercial Olympia à Tanjombato.{% endblock %}

{% block hero %}
  <section class="relative isolate overflow-hidden bg-olympia-dark text-white">
    <img src="{{ asset('images/hero-olympia.jpg') }}" alt="Galerie du centre commercial Olympia" width="1800" height="700" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 size-full object-cover object-center">
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-olympia-dark via-olympia-dark/90 to-olympia-dark/20"></div>
    <div class="container-site flex min-h-[360px] items-center py-16 md:min-h-[430px]">
      <div class="max-w-2xl">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-white/90">Actualités <span class="h-0.5 w-8 bg-olympia-gold"></span></p>
        <h1 class="mt-5 text-4xl font-bold leading-tight md:text-6xl">Les dernières nouvelles<br>du centre <span class="text-olympia-gold">Olympia</span></h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-white/90 md:text-lg">Découvrez les nouveautés, informations et moments forts qui font vivre votre centre commercial au quotidien.</p>
      </div>
    </div>
  </section>
{% endblock %}

{% block body %}
  <section class="container-site py-10 md:py-14">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <span class="pill-active">Toutes les actualités</span>
      <form role="search" method="get" action="{{ path('app_actualites') }}" class="flex w-full max-w-sm items-center gap-3 rounded-full border border-slate-200 bg-white px-5 py-3 shadow-sm">
        <svg class="size-5 shrink-0 text-olympia" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" value="{{ search }}" placeholder="Rechercher une actualité..." class="w-full bg-transparent text-sm text-olympia-ink placeholder:text-olympia-muted focus:outline-none">
      </form>
    </div>

    {% if featured %}
      <article class="mt-10 grid overflow-hidden rounded-2xl bg-sand-50 shadow-sm md:grid-cols-2">
        <div class="relative min-h-[280px] md:min-h-[360px]">
          {% set featured_srcset = responsive_srcset(featured.image) %}
          <img src="{{ asset(featured.image) }}"{% if featured_srcset %} srcset="{{ featured_srcset }}" sizes="(max-width: 768px) 100vw, 50vw"{% endif %} alt="{{ featured.title }}" class="absolute inset-0 size-full object-cover" loading="eager">
          <span class="absolute left-6 top-6 rounded-full bg-olympia-gold px-4 py-2 text-[11px] font-bold uppercase text-olympia">{{ featured.badge }}</span>
        </div>
        <div class="flex flex-col justify-center p-8 md:p-12">
          <p class="flex items-center gap-2 text-sm text-olympia-muted"><span class="text-olympia">▣</span> {{ featured.date }}</p>
          <h2 class="mt-5 text-3xl font-bold leading-tight text-olympia md:text-4xl">{{ featured.title }}</h2>
          <p class="mt-5 text-base leading-7 text-olympia-muted">{{ featured.text }}</p>
          <a href="{{ featured.href }}" class="mt-7 inline-flex w-fit items-center gap-2 rounded-full bg-olympia px-6 py-3 text-sm font-bold text-white transition hover:bg-olympia-dark">Lire l'article <span aria-hidden="true">→</span></a>
        </div>
      </article>
    {% endif %}

    <div class="mt-14 flex items-end justify-between gap-4">
      <div><p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-olympia-muted"><span class="h-0.5 w-8 bg-olympia-gold"></span> Découvrez aussi</p><h2 class="mt-3 text-3xl font-bold text-olympia">Nos dernières actualités</h2></div>
      <span class="hidden text-sm font-medium text-olympia-muted sm:block">{{ articles|length }} actualité{{ articles|length > 1 ? 's' : '' }}</span>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {% for article in articles %}
        <article class="group relative min-h-[390px] overflow-hidden rounded-xl bg-olympia-dark text-white shadow-sm">
          {% set article_srcset = responsive_srcset(article.image) %}
          <img src="{{ asset(article.image) }}"{% if article_srcset %} srcset="{{ article_srcset }}" sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"{% endif %} alt="{{ article.title }}" class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105" loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-black/10"></div>
          <div class="relative flex min-h-[390px] flex-col justify-end p-6">
            <span class="mb-auto w-fit rounded-full bg-olympia-gold px-3 py-1 text-[10px] font-bold uppercase text-olympia">{{ article.badge }}</span>
            <p class="text-sm text-white/75">{{ article.date }}</p><h3 class="mt-2 text-2xl font-bold leading-tight">{{ article.title }}</h3><p class="mt-3 line-clamp-3 text-sm leading-6 text-white/85">{{ article.text }}</p>
            <a href="{{ article.href }}" class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-white">En savoir plus <span aria-hidden="true">→</span></a>
          </div>
        </article>
      {% else %}
        <p class="text-sm text-olympia-muted">Aucune actualité ne correspond à votre recherche.</p>
      {% endfor %}
    </div>
    {% include 'components/_pagination.html.twig' with {pagination: pagination} only %}
  </section>
{% endblock %}
