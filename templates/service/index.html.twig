{% extends 'base.html.twig' %}

{% block title %}Services | Olympia Madagascar{% endblock %}

{% block main_background %}bg-[#0d3036]{% endblock %}

{% block body %}
  <section class="bg-[#0d3036] py-14 text-white md:py-20">
    <div class="container-site">
      <a href="{{ path('app_home') }}" class="mb-10 inline-flex items-center gap-2 text-sm font-semibold text-blue-100 transition hover:text-white">
        {% include 'components/ui/_icon.html.twig' with {name: 'arrow-right', class: 'size-4 rotate-180'} only %}
        Retour à l'accueil
      </a>

      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-600">À votre service</p>
          <h1 class="mt-2 text-3xl font-medium text-white md:text-5xl">Les services d'Olympia</h1>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-blue-100">Retrouvez les services et équipements disponibles pour rendre votre visite plus simple et agréable.</p>
        </div>
        <p class="text-sm text-blue-100">{{ services|length }} services disponibles</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {% for service in services %}
          {% if service.slug == 'animations-enfants' %}
            {% set icon = 'user' %}
          {% elseif service.slug in ['espace-familles', 'parking-gratuit'] %}
            {% set icon = 'building' %}
          {% else %}
            {% set icon = 'mail' %}
          {% endif %}

          <article id="{{ service.slug }}" class="group flex min-h-[324px] scroll-mt-24 flex-col overflow-hidden rounded-3xl bg-[#153f48] shadow-lg shadow-black/10 transition duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/20">
            <div class="relative flex h-36 shrink-0 items-center justify-center overflow-hidden {% if service.photoMedia %}bg-[#286574]{% else %}bg-[#f3f0eb]{% endif %}">
              {% if service.photoMedia %}
                {% set image_path = service.photoMedia.chemin %}
                {% set srcset = responsive_srcset(image_path) %}
                <img src="{{ asset(image_path) }}"{% if srcset %} srcset="{{ srcset }}" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"{% endif %} alt="{{ service.nom }}" width="800" height="500" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover opacity-80 transition duration-300 group-hover:scale-105">
                <div class="absolute inset-0 bg-gradient-to-br from-[#286574]/80 to-[#123e47]/60"></div>
                <span class="relative flex size-16 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-sm">
              {% else %}
                <span class="relative flex size-16 items-center justify-center rounded-full bg-white text-[#174c57] shadow-sm">
              {% endif %}
                  {% include 'components/ui/_icon.html.twig' with {name: icon, class: 'size-8'} only %}
                </span>
              {% if service.estMisEnAvant %}
                <span class="absolute right-4 top-3 rounded-full bg-sand-300 px-3 py-1 text-xs font-semibold text-brand-900">Populaire</span>
              {% endif %}
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-lg font-bold text-white">{{ service.nom }}</h2>
              {% if service.description %}
                <p class="mt-2 line-clamp-3 text-sm leading-6 text-blue-100">{{ service.description }}</p>
              {% endif %}
              {% if service.horaires %}
                <p class="mt-auto flex items-center gap-2 pt-5 text-sm text-blue-100">
                  {% include 'components/ui/_icon.html.twig' with {name: 'clock', class: 'size-4'} only %}
                  {{ service.horaires }}
                </p>
              {% endif %}
            </div>
          </article>
        {% else %}
          <p class="text-sm text-blue-100 sm:col-span-2 lg:col-span-4">Les services seront bientôt disponibles.</p>
        {% endfor %}
      </div>
    </div>
  </section>
{% endblock %}
