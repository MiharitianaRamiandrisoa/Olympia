{% extends 'base.html.twig' %}

{% block title %}Informations pratiques Olympia Madagascar | Horaires et accès{% endblock %}
{% block meta_description %}Préparez votre visite à Olympia Madagascar : horaires, adresse, accès et informations pratiques du centre commercial à Tanjombato.{% endblock %}

{% block hero %}
  <nav aria-label="Fil d'Ariane" class="border-b border-slate-100 bg-olympia-cream">
    <ol class="container-site flex items-center gap-2 py-4 text-sm text-olympia-muted">
      <li><a href="{{ path('app_home') }}" class="hover:text-olympia">Accueil</a></li>
      <li aria-hidden="true">›</li>
      <li class="font-medium text-olympia-ink" aria-current="page">Informations pratiques</li>
    </ol>
  </nav>
  {% include 'components/_hero.html.twig' with {
    title: 'Informations pratiques',
    subtitle: 'Horaires, adresse et informations utiles pour préparer votre visite à Olympia.',
    image: 'images/hero-olympia3.JPG'
  } only %}
{% endblock %}

{% block body %}
  <section class="container-site py-12 md:py-16">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      {% if address %}
        <article class="rounded-3xl bg-white p-8 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-wide text-olympia-gold">Accès</p>
          <h2 class="mt-3 text-3xl font-medium text-olympia">{{ address.titre }}</h2>
          <p class="mt-5 whitespace-pre-line text-base leading-7 text-olympia-muted">{{ address.contenu }}</p>
          <a href="{{ path('app_home') }}#localisation" class="mt-7 inline-flex rounded-full bg-olympia px-5 py-3 text-sm font-bold text-white hover:bg-olympia-dark">
            Voir la localisation
          </a>
        </article>
      {% endif %}

      <article class="rounded-3xl bg-white p-8 shadow-sm{% if not address %} lg:col-span-2{% endif %}">
        <p class="text-xs font-bold uppercase tracking-wide text-olympia-gold">Votre visite</p>
        <h2 class="mt-3 text-3xl font-medium text-olympia">Horaires et informations utiles</h2>
        {% if items %}
          <div class="mt-8 space-y-7">
            {% for item in items %}
              <div class="border-b border-slate-100 pb-6 last:border-0 last:pb-0">
                <h3 class="text-lg font-bold text-olympia">{{ item.titre }}</h3>
                <p class="mt-2 whitespace-pre-line text-sm leading-7 text-olympia-muted">{{ item.contenu }}</p>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="mt-6 text-sm leading-7 text-olympia-muted">Les informations pratiques seront bientôt disponibles.</p>
        {% endif %}
      </article>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-4 bg-sand-50 px-8 py-7 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl font-medium text-olympia">Une question sur votre visite ?</h2>
        <p class="mt-1 text-sm text-olympia-muted">L'équipe Olympia est à votre écoute.</p>
      </div>
      <a href="{{ path('app_contact') }}" class="rounded-full bg-olympia-gold px-6 py-3 text-sm font-bold text-olympia">
        Contacter Olympia →
      </a>
    </div>
  </section>
{% endblock %}
