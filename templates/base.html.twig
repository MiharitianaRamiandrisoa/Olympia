<!DOCTYPE html>
<html lang="fr">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4G3PZGPQJ1"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-4G3PZGPQJ1');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set seo_title %}{% block title %}Olympia Centre Commercial{% endblock %}{% endset %}
  {% set seo_title = seo_title|striptags|trim %}
  {% set seo_description %}{% block meta_description %}Olympia Madagascar : centre commercial à Tanjombato, boutiques, Food court, services et événements.{% endblock %}{% endset %}
  {% set seo_description = seo_description|striptags|trim %}
  {% set canonical_url = app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo %}
  {% if app.request.query.get('page') %}
    {% set canonical_url = canonical_url ~ '?page=' ~ app.request.query.get('page') %}
  {% endif %}
  {% set seo_image = app.request.schemeAndHttpHost ~ app.request.baseUrl ~ asset('images/hero-olympia.jpg') %}
  <meta name="description" content="{{ seo_description }}">
  <meta name="author" content="Olympia Madagascar">
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#154953">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="{{ asset('images/logo/favico/favicon.ico') }}?v=olympia-4" sizes="any">
  <link rel="icon" href="{{ asset('images/logo/favico/favicon-32x32.png') }}?v=olympia-4" type="image/png" sizes="32x32">
  <link rel="icon" href="{{ asset('images/logo/favico/favicon-16x16.png') }}?v=olympia-4" type="image/png" sizes="16x16">
  <link rel="apple-touch-icon" href="{{ asset('images/logo/favico/apple-touch-icon.png') }}?v=olympia-4">
  <link rel="manifest" href="{{ asset('images/logo/favico/site.webmanifest') }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_MG">
  <meta property="og:site_name" content="Olympia Madagascar">
  <meta property="og:title" content="{{ seo_title }}">
  <meta property="og:description" content="{{ seo_description }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ seo_image }}">
  <meta property="og:image:alt" content="Centre commercial Olympia à Tanjombato">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title }}">
  <meta name="twitter:description" content="{{ seo_description }}">
  <meta name="twitter:image" content="{{ seo_image }}">
  <meta name="twitter:image:alt" content="Centre commercial Olympia à Tanjombato">
  <title>{{ seo_title }}</title>
  {% block head_preloads %}{% endblock %}
  {# Versionner l'asset force le navigateur/CDN à prendre la CSS déployée. #}
  <link rel="stylesheet" href="{{ asset('build/app.css') }}?v=20261009-2">
  {{ importmap('app') }}
  {% block stylesheets %}{% endblock %}
  {% block structured_data %}
    <script type="application/ld+json">
      {{ {
        '@context': 'https://schema.org',
        '@type': 'ShoppingCenter',
        'name': 'Olympia Madagascar',
        'url': app.request.schemeAndHttpHost,
        'logo': app.request.schemeAndHttpHost ~ asset('images/logo/logo-header-teal.png'),
        'sameAs': [
          'https://www.facebook.com/profile.php?id=61575812981322',
          'https://www.instagram.com/olympia_madagascar/'
        ],
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': 'Tanjombato',
          'addressCountry': 'MG'
        }
      }|json_encode|raw }}
    </script>
  {% endblock %}
</head>
<body class="flex min-h-screen flex-col">
  {% include 'components/_header.html.twig' %}

  <main class="brand-pattern flex-1 {% block main_background %}bg-olympia-cream{% endblock %}">
    {% block hero %}{% endblock %}
    {% block filters %}{% endblock %}
    {% block body %}{% endblock %}
  </main>

  {% include 'components/_footer.html.twig' %}
  {% block javascripts %}{% endblock %}
</body>
</html>
