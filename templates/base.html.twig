<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Olympia Centre Commercial{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet"></noscript>
  {% block head_preloads %}{% endblock %}
  <link rel="stylesheet" href="{{ asset('build/app.css') }}?v=services-20261001">
  {{ importmap('app') }}
  {% block stylesheets %}{% endblock %}
</head>
<body class="flex min-h-screen flex-col">
  {% include 'components/_header.html.twig' %}

  <main class="flex-1 {% block main_background %}bg-olympia-cream{% endblock %}">
    {% block hero %}{% endblock %}
    {% block filters %}{% endblock %}
    {% block body %}{% endblock %}
  </main>

  {% include 'components/_footer.html.twig' %}
  {% block javascripts %}{% endblock %}
</body>
</html>
